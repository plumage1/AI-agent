# LLM
LLM_PROVIDER=codex_cli
CODEX_CLI_PATH=codex.cmd
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120

API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.1

# App
APP_NAME=AI Job Agent
APP_ENV=local
ADMIN_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=5242880
MAX_TEXT_LENGTH=20000
MAX_TOP_K=10
SESSION_TTL_SECONDS=86400

# Redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
LANGGRAPH_CHECKPOINTER_BACKEND=auto
TESSERACT_CMD=

# RAG
# hybrid: 同时使用 Chroma 语义检索和关键词检索，再做本地 rerank
# chroma: 使用 Chroma 本地向量数据库，持久化保存 embeddings
# embedding: 使用 BAAI/bge-small-zh-v1.5 做语义检索，但只缓存在进程内
# keyword: 使用关键词打分检索，适合对照测试
RAG_RETRIEVER=hybrid
RAG_MIN_SCORE=0.5
RAG_CONTEXT_MAX_CHARS=4200
